<div class="row border-bottom border-warning-subtle d-flex justify-content-center align-items-center" style="min-height: 65%; max-height: 65%;">
  <div class="col p-5 border border-light rounded-5" style="min-width: 50%; max-width: 50%;">
    <h2>Sign in</h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <br>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: "form-control" %>
      <br>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "form-control" %>
      <br>
      <% if devise_mapping.rememberable? %>
        <div class="form-check">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, class: "form-check-label" %>
        </div>
      <% end %>
      <br>
      <div class="actions">
        <%= f.submit "Log in", class: "btn btn-outline-warning" %>
      </div>
    <% end %>
    <br>
    <%= render "devise/shared/links" %>
  </div>
</div>
