<!DOCTYPE html>
<html>
  <head>
    <title>BankTeleSys</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-bs-theme="dark" class="container-fluid vh-100 vw-100 d-flex justify-content-center align-items-center">
    <div class="row shadow border border-warning-subtle rounded-5" style="height: 97vh; width: 70vw;">
      <div class="col w-100 h-100">
        <div class="row border-bottom border-warning-subtle" style="max-height: 10%; min-height: 10%;">
          <div class="col d-flex justify-content-center align-items-center" style="max-width: 20%; min-width: 20%;" id="title">
            <h3 class="text-light-emphasis">
              <%= link_to "BankTeleSys", root_path, class: "link-light link-underline-opacity-0" %>
            </h3>
          </div>
          <div class="col d-flex justify-content-center align-items-center" style="max-width: 50%; min-width: 50%;" id="alerts">
            <% if flash[:notice] %>
              <div class="alert alert-light alert-dismissible fade show" role="alert">
                <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>
          </div>
          <div class="col column-gap-3 d-flex justify-content-center align-items-center" style="max-width: 30%; min-width: 30%;" id="exit">
            <% if user_signed_in? %>
              <%= link_to "Customers", customers_path, class: "btn btn-outline-warning" %>
              <%= link_to "Edit Profile", edit_user_registration_path, class: "btn btn-outline-warning" %>
              <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-light" %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, class: "btn btn-outline-light" %>
              <%= link_to "Sign up", new_user_registration_path, class: "btn btn-outline-light" %>
            <% end %>
          </div>
        </div>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
