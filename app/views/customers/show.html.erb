<div class="row" style="max-height: 65%; min-height: 65%;">
  <div class="col px-5">

    <div class="row" style="max-height: 20%; min-height: 20%;">
      <div class="col d-flex justify-content-start align-items-center">
        <h2 class="text-light-emphasis">Customer: <%= @customer.id %></h2>
      </div>
    </div>

    <div class="row border-bottom border-warning-subtle" style="max-height: 40vh; min-height: 40vh; overflow-y: scroll;">
      <div class="col">
        <%= render @customer %>
      </div>
    </div>

    <div class="row" style="max-height: 15%; min-height: 15%;">
      <div class="col input-group d-flex justify-content-start align-items-center">
        <%= link_to "Edit this customer", edit_customer_path(@customer), class: "btn btn-outline-warning" %> 
        <%= link_to "Back to customers", customers_path, class: "btn btn-outline-warning" %>
      </div>
      <div class="col input-group d-flex justify-content-end align-items-center">
        <%= button_to "Destroy this customer", @customer, method: :delete, class: "btn btn-outline-danger" %>
      </div>
    </div>

  </div>
</div>

<%= render partial: "tools" %>
