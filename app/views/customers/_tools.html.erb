<div class="row border-top border-warning-subtle" style="max-height: 25%; min-height: 25%;">
  <div class="col p-5">

    <div class="row">
      <div class="col" style="max-width: 60%; min-width: 60%;">
        <%= form_tag customers_path, class: "input-group", method: :get, remote: true do %>
          <span class="input-group-text">Query Tool:</span>
          <%= text_field_tag :column_name, params[:column_name], class: "form-control", placeholder: "Column" %>
          <%= text_field_tag :column_value, params[:column_value], class: "form-control", placeholder: "Value" %>
          <%= submit_tag "Search", class: 'btn btn-outline-warning', style: "width: 20%;" %>
        <% end %>
      </div>

      <div class="col" style="max-width: 40%; min-width: 40%;">
        <%= form_tag customers_path, class: "input-group", method: :get, remote: true do %>
          <span class="input-group-text">ID Tool:</span>
          <%= text_field_tag :customer_id, params[:customer_id], class: "form-control", placeholder: "Customer ID" %>
          <%= submit_tag "Show", class: "btn btn-outline-warning", style: "width: 20%;" %>
        <% end %>
      </div>
    </div>

    <br>

    <div class="row">
      <div class="col" style="max-width: 60%; min-width: 60%;">
        <%= form_tag(customers_import_customers_path, multipart: true, class: "input-group") do %>
          <%= file_field_tag :file, class: "form-control", data: {toggle: "tooltip"} %>
          <%= hidden_field_tag :user_id, current_user.id %>
          <%= submit_tag "Import CSV", class: "btn btn-outline-warning", style: "width: 20%;" %>
        <% end %>
      </div>

      <div class="col" style="max-width: 40%; min-width: 40%;">
        <%= form_tag customers_action_customers_path, class: "input-group", method: :post, remote: true do %>
          <span class="input-group-text">API Tool</span>
          <%= hidden_field_tag :user_id, current_user.id %>
          <%= select_tag :action_type, options_for_select([["Prediction","prediction"],["Training","training/new"]]), class: "form-select" %>
          <%= submit_tag 'Action', class: 'btn btn-outline-warning', style: "width: 20%;", id: "model-action" %>
        <% end %>
      </div>
    </div>

  </div>
</div>
